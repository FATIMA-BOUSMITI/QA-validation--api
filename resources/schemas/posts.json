{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JSONPlaceholder posts collection",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["userId", "id", "title", "body"],
    "properties": {
      "userId": {"type": "integer"},
      "id": {"type": "integer"},
      "title": {"type": "string"},
      "body": {"type": "string"}
    }
  }
}
